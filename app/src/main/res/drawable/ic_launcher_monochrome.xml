    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.70"
        android:scaleY="0.70"
        android:translateX="16.2"
        android:translateY="16.2">

        <!-- 书脊 -->
        <path
            android:pathData="M 28,24 L 34,24 A 4,4 0 0 1 38,28 L 38,80 A 4,4 0 0 1 34,84 L 28,84 A 4,4 0 0 1 24,80 L 24,28 A 4,4 0 0 1 28,24 Z"
            android:fillColor="#FFFFFF" />

        <!-- 书页厚度（右下） -->
        <path
            android:pathData="M 34,28 L 82,28 A 4,4 0 0 1 86,32 L 86,84 A 4,4 0 0 1 82,88 L 34,88 A 4,4 0 0 1 30,84 L 30,32 A 4,4 0 0 1 34,28 Z"
            android:fillColor="#FFFFFF" />

        <!-- 主封面 -->
        <path
            android:pathData="M 36,26 L 80,26 A 4,4 0 0 1 84,30 L 84,78 A 4,4 0 0 1 80,82 L 36,82 A 4,4 0 0 1 32,78 L 32,30 A 4,4 0 0 1 36,26 Z"
            android:fillColor="#FFFFFF" />

    </group>
</vector>
